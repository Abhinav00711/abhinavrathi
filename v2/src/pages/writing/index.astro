---
import { getCollection } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import CommandPalette from "@components/CommandPalette.astro";
import ScrollProgress from "@components/ScrollProgress.astro";
import RevealMotion from "@components/RevealMotion.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = (
  await getCollection("posts", (p) => !p.data.draft && p.data.published <= new Date())
).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

// Always surface drafts in a separate section so Abhinav can see his own
// outlines from /writing/ while iterating, without leaking to recruiters via
// the homepage Writing card or the RSS feed.
const drafts = (
  await getCollection("posts", (p) => p.data.draft)
).sort((a, b) => b.data.published.getTime() - a.data.published.getTime());

const fmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Layout
  title="Writing — Abhinav Rathi"
  description="One post a month on backend engineering at the boundary of code and money."
  canonicalPath="/writing/"
>
  <ScrollProgress />
  <Nav />

  <main id="main" class="pt-32 pb-24">
    <article class="container-prose" style="max-width: 760px;">
      <a
        href={`${base}/`}
        class="font-mono text-[13px]"
        style="color: var(--color-muted);"
        >← Home</a
      >

      <header class="mt-8">
        <p class="eyebrow mb-3">Writing</p>
        <h1 class="headline" style="font-size: var(--text-h1);">
          Notes from production.
        </h1>
        <p class="mt-5 text-[18px]" style="color: var(--color-muted);">
          Engineering at the boundary of code and money. One post a month.
          <a
            href={`${base}/rss.xml`}
            class="ml-2 mono text-[13px] underline"
            style="color: var(--color-accent-text); text-underline-offset: 3px;"
          >RSS →</a>
        </p>
      </header>

      <hr class="hairline my-12" />

      {
        posts.length === 0 ? (
          <div
            class="rounded-md border p-8 text-center"
            style="border-color: var(--color-hairline); background: var(--color-panel);"
          >
            <p class="mono text-[13px]" style="color: var(--color-faint);">
              [ first post in progress ]
            </p>
            <p class="mt-3" style="color: var(--color-muted);">
              Working on the inaugural post — a write-up of latency lessons
              from the prop-trading backend at Axxela. Subscribe to the
              {" "}<a href={`${base}/rss.xml`} style="color: var(--color-accent-text); text-decoration: underline;">RSS feed</a>{" "}
              for the publish notification.
            </p>
          </div>
        ) : (
          <ul class="flex flex-col">
            {posts.map((post) => (
              <li>
                <a
                  href={`${base}/writing/${post.id}/`}
                  class="post-row group flex items-center justify-between gap-6 border-b py-5 transition-colors"
                  style="border-color: var(--color-hairline);"
                >
                  <div>
                    <h3
                      class="text-white"
                      style="font-size: 18px; font-weight: 500; letter-spacing: -0.01em;"
                    >
                      {post.data.title}
                    </h3>
                    <p class="mt-1 text-[14px]" style="color: var(--color-muted);">
                      {post.data.summary}
                    </p>
                  </div>
                  <span
                    class="mono text-[12px] uppercase tracking-wider"
                    style="color: var(--color-faint);"
                  >
                    {fmt.format(post.data.published)}
                  </span>
                </a>
              </li>
            ))}
          </ul>
        )
      }

      {
        drafts.length > 0 && (
          <>
            <h2
              class="headline mt-16"
              style="font-size: var(--text-h3); color: var(--color-muted);"
            >
              In progress
            </h2>
            <p class="mt-2 text-[14px]" style="color: var(--color-faint);">
              Outlines visible to Abhinav while iterating; not in the RSS feed.
            </p>
            <ul class="mt-6 flex flex-col">
              {drafts.map((post) => (
                <li>
                  <a
                    href={`${base}/writing/${post.id}/`}
                    class="post-row flex items-center justify-between gap-6 border-b py-5"
                    style="border-color: var(--color-hairline);"
                  >
                    <div>
                      <h3
                        class="text-white"
                        style="font-size: 16px; font-weight: 500;"
                      >
                        {post.data.title}
                      </h3>
                      <p class="mt-1 text-[13px]" style="color: var(--color-muted);">
                        {post.data.summary}
                      </p>
                    </div>
                    <span
                      class="mono text-[12px] uppercase tracking-wider"
                      style="color: var(--color-accent-text);"
                    >
                      Draft
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          </>
        )
      }
    </article>
  </main>

  <Footer />
  <CommandPalette />
  <RevealMotion />
</Layout>

<style>
  .post-row:hover h3,
  .post-row:focus-visible h3 {
    color: var(--color-accent-text);
  }
</style>
