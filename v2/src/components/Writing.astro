---
import { getCollection } from "astro:content";
import Section from "./Section.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const posts = (await getCollection("posts", (p) => !p.data.draft))
  .sort(
    (a, b) => b.data.published.getTime() - a.data.published.getTime()
  )
  .slice(0, 3);

const fmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
});
---

<Section
  id="writing"
  eyebrow="Writing"
  title="Notes from production."
  intro="One post a month — engineering at the boundary of code and money."
  aside={{ label: "All posts", href: `${base}/writing/` }}
>
  {
    posts.length === 0 ? (
      <div
        class="reveal rounded-md border p-8 text-center"
        style="border-color: var(--color-hairline); background: var(--color-panel);"
      >
        <p class="mono text-[13px]" style="color: var(--color-faint);">
          [ first post in progress ]
        </p>
        <p class="mt-3 text-[15px]" style="color: var(--color-muted);">
          Working title:{" "}
          <em>"What I learned about latency working at a prop trading firm."</em>
        </p>
      </div>
    ) : (
      <ul class="reveal flex flex-col">
        {posts.map((post) => (
          <li>
            <a
              href={`${base}/writing/${post.id}/`}
              class="post-row group flex items-center justify-between gap-6 border-b py-5 transition-colors"
              style="border-color: var(--color-hairline);"
              data-post-row
            >
              <div>
                <h3
                  class="text-white"
                  style="font-size: 18px; font-weight: 500; letter-spacing: -0.01em;"
                >
                  {post.data.title}
                </h3>
                <p class="mt-1 text-[14px]" style="color: var(--color-muted);">
                  {post.data.summary}
                </p>
              </div>
              <span
                class="mono text-[12px] uppercase tracking-wider"
                style="color: var(--color-faint);"
              >
                {fmt.format(post.data.published)}
              </span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Section>

<style>
  /* AA-clearing accent for the post-row title hover. Replaces the old color
     swap on the title — hits :focus-visible too so keyboard users get parity. */
  .post-row:hover h3,
  .post-row:focus-visible h3 {
    color: var(--color-accent-text);
  }
</style>
