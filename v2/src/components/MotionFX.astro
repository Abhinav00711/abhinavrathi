---
/**
 * Pointer-driven motion behaviors, opt-in per element via data attributes:
 *
 *   [data-tilt]      3D perspective tilt that tracks the cursor, with a glare
 *                    highlight driven through --glare-x / --glare-y / --glare-o
 *                    (consumed by e.g. WorkTile's .tile__glare layer).
 *   [data-magnetic]  Element leans toward the cursor while hovered and springs
 *                    back on leave. Used on the hero CTAs.
 *
 * Both run a per-element rAF lerp that stops as soon as the element converges
 * on its target — zero cost while the cursor rests or nothing is hovered.
 *
 * Gated to hover-capable fine pointers. prefers-reduced-motion is consulted
 * live: handlers no-op while it's on, and flipping it mid-hover resets any
 * element that's currently animating (mirrors Hero3D's live teardown).
 *
 * While a loop steers `transform`, the element's transition-property is set
 * inline to everything-but-transform. Inline (rather than a CSS class rule)
 * because an equal-specificity Astro-scoped rule like WorkTile's `.tile`
 * would win the cascade tie on stylesheet order and re-introduce the 200ms
 * transform transition — smearing the tilt behind the cursor.
 */
---

<script>
  (() => {
    if (!window.matchMedia("(hover: hover) and (pointer: fine)").matches) {
      return;
    }
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;

    const NO_TRANSFORM_TRANSITIONS =
      "border-color, background, color, box-shadow, opacity";

    // Every active element registers a reset here so a mid-session
    // reduced-motion switch can stop it instantly.
    const activeResets = new Set<() => void>();
    reduce.addEventListener("change", () => {
      if (!reduce.matches) return;
      activeResets.forEach((reset) => reset());
      activeResets.clear();
    });

    /* ------------------------------------------------------------------ *
     * Tilt
     * ------------------------------------------------------------------ */
    document.querySelectorAll<HTMLElement>("[data-tilt]").forEach((el) => {
      const maxDeg = Number(el.dataset.tiltMax || 6);
      let raf = 0;
      let rx = 0, ry = 0, trx = 0, try_ = 0;

      const reset = () => {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        rx = ry = trx = try_ = 0;
        el.classList.remove("tilting");
        el.style.transitionProperty = "";
        el.style.transform = "";
        el.style.setProperty("--glare-o", "0");
        activeResets.delete(reset);
      };

      const frame = () => {
        raf = 0;
        rx = lerp(rx, trx, 0.16);
        ry = lerp(ry, try_, 0.16);
        el.style.transform =
          `perspective(900px) rotateX(${rx.toFixed(3)}deg) ` +
          `rotateY(${ry.toFixed(3)}deg) translateY(-2px)`;
        // Keep going only until we've converged on the target — pointermove
        // reschedules whenever the target shifts.
        if (Math.abs(rx - trx) > 0.02 || Math.abs(ry - try_) > 0.02) {
          raf = requestAnimationFrame(frame);
        }
      };
      const schedule = () => {
        if (!raf) raf = requestAnimationFrame(frame);
      };

      el.addEventListener("pointerenter", () => {
        if (reduce.matches) return;
        el.classList.add("tilting");
        el.style.transitionProperty = NO_TRANSFORM_TRANSITIONS;
        activeResets.add(reset);
        schedule();
      });

      el.addEventListener(
        "pointermove",
        (e: PointerEvent) => {
          if (reduce.matches) return;
          const r = el.getBoundingClientRect();
          const px = (e.clientX - r.left) / r.width; // 0..1
          const py = (e.clientY - r.top) / r.height;
          trx = (0.5 - py) * maxDeg;
          try_ = (px - 0.5) * maxDeg;
          el.style.setProperty("--glare-x", `${(px * 100).toFixed(1)}%`);
          el.style.setProperty("--glare-y", `${(py * 100).toFixed(1)}%`);
          el.style.setProperty("--glare-o", "1");
          schedule();
        },
        { passive: true }
      );

      // Hand the transform back to CSS; .tile's transition eases it home.
      el.addEventListener("pointerleave", reset);
    });

    /* ------------------------------------------------------------------ *
     * Magnetic
     * ------------------------------------------------------------------ */
    document.querySelectorAll<HTMLElement>("[data-magnetic]").forEach((el) => {
      const strength = Number(el.dataset.magneticStrength || 0.3);
      const maxShift = 10; // px — subtle pull, not a chase
      let raf = 0;
      let hovering = false;
      let x = 0, y = 0, tx = 0, ty = 0;

      const reset = () => {
        if (raf) cancelAnimationFrame(raf);
        raf = 0;
        hovering = false;
        x = y = tx = ty = 0;
        el.classList.remove("magnetizing");
        el.style.transitionProperty = "";
        el.style.transform = "";
        activeResets.delete(reset);
      };

      const frame = () => {
        raf = 0;
        x = lerp(x, tx, 0.18);
        y = lerp(y, ty, 0.18);
        const settled = Math.abs(x - tx) < 0.05 && Math.abs(y - ty) < 0.05;
        if (settled) {
          x = tx;
          y = ty;
        }
        if (!hovering && settled && tx === 0 && ty === 0) {
          // Spring fully returned — clean up and hand back to CSS.
          reset();
          return;
        }
        el.style.transform = `translate(${x.toFixed(2)}px, ${y.toFixed(2)}px)`;
        // Stop at convergence; pointermove reschedules on new targets.
        if (!settled) raf = requestAnimationFrame(frame);
      };
      const schedule = () => {
        if (!raf) raf = requestAnimationFrame(frame);
      };

      el.addEventListener("pointerenter", () => {
        if (reduce.matches) return;
        hovering = true;
        el.classList.add("magnetizing");
        el.style.transitionProperty = NO_TRANSFORM_TRANSITIONS;
        activeResets.add(reset);
        schedule();
      });
      el.addEventListener(
        "pointermove",
        (e: PointerEvent) => {
          if (reduce.matches || !hovering) return;
          const r = el.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          tx = Math.max(-maxShift, Math.min(maxShift, dx * strength));
          ty = Math.max(-maxShift, Math.min(maxShift, dy * strength));
          schedule();
        },
        { passive: true }
      );
      el.addEventListener("pointerleave", () => {
        hovering = false;
        tx = 0;
        ty = 0;
        schedule(); // spring back, then frame() calls reset() at rest
      });
    });
  })();
</script>
