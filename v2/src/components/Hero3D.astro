---
/**
 * WebGL hero background host — the actual Three.js scene lives in
 * src/scripts/hero3d.ts and loads lazily (own chunk, post-idle) so it never
 * competes with the headline for first paint.
 *
 * Renders nothing at all when any gate fails; the existing gradient halo is
 * the fallback aesthetic, not a degraded one:
 *   - prefers-reduced-motion (also torn down live if the user flips it on)
 *   - no WebGL2 (three r180 requires it)
 *   - Save-Data connections
 */
---

<div class="hero3d" data-hero3d aria-hidden="true"></div>

<script>
  (() => {
    const host = document.querySelector<HTMLElement>("[data-hero3d]");
    if (!host) return;

    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    const saveData = (
      navigator as Navigator & { connection?: { saveData?: boolean } }
    ).connection?.saveData;
    if (saveData) return;

    const probe = document.createElement("canvas");
    const gl = probe.getContext("webgl2");
    if (!gl) return;
    gl.getExtension("WEBGL_lose_context")?.loseContext();

    let teardown: (() => void) | null = null;
    let loading = false;

    const boot = async () => {
      if (teardown || loading || reduce.matches) return;
      loading = true;
      try {
        const { initHero3D } = await import("../scripts/hero3d");
        if (!reduce.matches) teardown = initHero3D(host);
      } catch {
        /* chunk failed to load (flaky network) — gradient fallback remains */
      }
      loading = false;
    };

    const whenIdle = (cb: () => void) => {
      if ("requestIdleCallback" in window) {
        window.requestIdleCallback(cb, { timeout: 2000 });
      } else {
        setTimeout(cb, 350);
      }
    };

    if (!reduce.matches) whenIdle(boot);

    // Honor a mid-session switch in either direction.
    reduce.addEventListener("change", () => {
      if (reduce.matches) {
        teardown?.();
        teardown = null;
      } else {
        whenIdle(boot);
      }
    });
  })();
</script>

<style>
  .hero3d {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero3d :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }
</style>
