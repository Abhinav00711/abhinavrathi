---
import Hero3D from "@components/Hero3D.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Eyebrow facts — currently-true. Update if role/location changes.
const eyebrow = "Currently — ML & Backend @ Axxela · Kolkata, IN";

// Positioning sentence (Phase A.1 — ML-foreground pivot, 2026-05-12).
// Split into two visual lines for cadence.
const headlineLineOne = "ML engineer shipping production Python";
const headlineLineTwo =
  "at a prop trading firm. Models, services, and the infrastructure that puts the two together.";

// Metric strip (Phase A.1 — picked 2026-05-12). Years + tagline + case studies.
// Kept as three logical cells; the grid wraps to 2-col on mobile.
const metrics: Array<{ k: string; v: string }> = [
  { k: "in production", v: "3 yrs" },
  { k: "applied ML where", v: "bugs cost dollars" },
  { k: "case studies", v: "6 dated · metric-backed" },
  { k: "open to", v: "senior roles" },
];
---

<section
  class="relative overflow-hidden pt-32 pb-24 md:pt-40 md:pb-32"
  data-hero
>
  <!-- subtle dot grid is applied to body; this layer adds a soft cobalt halo -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-0"
    style="
      background:
        radial-gradient(60% 50% at 18% 20%, rgba(61,82,254,0.10), transparent 70%),
        radial-gradient(45% 40% at 88% 80%, rgba(61,82,254,0.06), transparent 75%);
    "
  >
  </div>

  <!-- Cursor-follow spotlight (desktop, hover-capable, motion-OK only).
       Reads --spot-x / --spot-y CSS variables set by the pointermove listener. -->
  <div aria-hidden="true" class="cursor-spotlight"></div>

  <!-- Readability scrim between the WebGL canvas (z-0) and the copy (z-10):
       the moving point field otherwise drops glyph-local contrast on the
       eyebrow/paragraph. color-mix on the surface token keeps it correct in
       all three themes with no JS. -->
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
    style="
      z-index: 1;
      background: radial-gradient(
        75% 70% at 32% 42%,
        color-mix(in srgb, var(--color-surface) 85%, transparent),
        color-mix(in srgb, var(--color-surface) 55%, transparent) 55%,
        transparent 78%
      );
    "
  >
  </div>

  <div class="container-prose relative z-10">
    <p class="eyebrow reveal">{eyebrow}</p>

    <h1
      class="headline reveal mt-6 max-w-[16ch]"
      style="--reveal-delay: 80ms;"
      data-typer
    >
      <span class="block" data-typer-line>{headlineLineOne}</span>
      <span class="mt-2 block text-muted-display" data-typer-line>{headlineLineTwo}</span>
    </h1>

    <!-- Scan-line for the first-visit terminal intro. Only animates while the
         hero has `.intro-active`. Gated everywhere by prefers-reduced-motion. -->
    <div aria-hidden="true" class="hero-scanline" data-hero-scanline></div>

    <p class="reveal mt-8 max-w-prose text-[17px] text-muted" style="--reveal-delay: 160ms;">
      I do applied ML at a place where the model's output becomes a real
      order — which is a very effective way to learn what &quot;good enough&quot;
      isn't. Equally comfortable in the eval harness, the serving layer, and
      the Flask + MySQL plumbing that connects them.
    </p>

    <!-- metric strip -->
    <ul
      class="reveal mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-md border md:grid-cols-4"
      style="border-color: var(--color-hairline); background: var(--color-hairline); --reveal-delay: 240ms;"
    >
      {
        metrics.map((m) => (
          <li
            class="flex flex-col gap-1 px-4 py-3"
            style="background: var(--color-surface);"
          >
            <span class="mono text-[11px] uppercase tracking-wider text-faint">
              {m.k}
            </span>
            <span class="mono text-[15px] text-white">{m.v}</span>
          </li>
        ))
      }
    </ul>

    <!-- CTAs -->
    <div class="reveal mt-10 flex flex-wrap items-center gap-3" style="--reveal-delay: 320ms;">
      <a href="#work" class="btn btn-primary" data-magnetic
        >View case studies
        <span aria-hidden="true">→</span>
      </a>
      <a
        href="mailto:rathiabhinav01@gmail.com?subject=Senior%20role%20inquiry&body=Hi%20Abhinav%2C%0A%0A"
        class="btn btn-secondary"
        data-magnetic
      >
        Email me
      </a>
      <span class="ml-2 hidden items-center gap-2 text-xs text-faint sm:inline-flex">
        or press <span class="kbd">K</span> for quick actions
      </span>
    </div>
  </div>

  <!-- WebGL "signal surface" — lazy Three.js scene behind the copy (the
       canvas layers at z-0 regardless of DOM order; mounting after the copy
       puts the scene's pause toggle last in the hero's tab order). Gated on
       reduced-motion / hardware WebGL2 / Save-Data; the halo is the fallback. -->
  <Hero3D />
</section>

<script>
  /**
   * First-visit terminal intro for the hero.
   *
   *   1. A cobalt scan-line sweeps once across the hero (~900ms).
   *   2. The headline types itself character-by-character with a cursor that
   *      hops between the two lines.
   *   3. Cursor blinks for one cycle on the final line, then fades.
   *
   * Fires once per browser (stored in `localStorage["hero-intro-seen"]`).
   * Bypass paths:
   *   - URL `?intro` (for sharing / demoing the intro)
   *   - `hero:replay-intro` CustomEvent (wired to the Cmd-K palette)
   * Bails entirely under `prefers-reduced-motion`.
   * Skippable by any keydown / pointerdown while the intro is running.
   */
  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    const headline = hero?.querySelector<HTMLElement>("[data-typer]");
    if (!hero || !headline) return;

    const FLAG_KEY = "hero-intro-seen";
    const reduceMotion = () =>
      window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const forceReplay = new URLSearchParams(window.location.search).has("intro");

    const lines = Array.from(
      headline.querySelectorAll<HTMLElement>("[data-typer-line]")
    );
    // Cache the source-of-truth text — frontmatter strings, untouched.
    const originals = lines.map((el) => el.textContent ?? "");

    let running = false;
    let skipHandler: ((e: Event) => void) | null = null;

    const sleep = (ms: number) =>
      new Promise<void>((res) => setTimeout(res, ms));

    const detachSkip = () => {
      if (!skipHandler) return;
      window.removeEventListener("keydown", skipHandler);
      window.removeEventListener("pointerdown", skipHandler);
      skipHandler = null;
    };

    const finish = () => {
      running = false;
      detachSkip();
      lines.forEach((el, i) => {
        el.textContent = originals[i];
        el.classList.remove("has-cursor");
      });
      headline.classList.remove("is-typing");
      hero.classList.remove("intro-active");
      headline.removeAttribute("aria-busy");
      try {
        localStorage.setItem(FLAG_KEY, "1");
      } catch {
        /* private mode etc. — just skip persistence */
      }
    };

    const playIntro = async () => {
      if (running) return;
      if (reduceMotion()) {
        finish();
        return;
      }
      running = true;

      // Keep the surrounding reveals in their normal stagger; just take over
      // the headline. Force it visible so the reveal observer's opacity:0
      // never beats us to the paint.
      lines.forEach((el) => {
        el.textContent = "";
      });
      headline.classList.add("is-visible", "is-typing");
      headline.style.setProperty("--reveal-delay", "0ms");
      headline.setAttribute("aria-busy", "true");
      hero.classList.add("intro-active");

      // Any meaningful keydown or pointerdown skips to the final state.
      // We keep the listener attached for the whole intro so a modifier-only
      // press (Shift/Alt) doesn't quietly consume the user's only skip chance.
      skipHandler = (e: Event) => {
        if (!running) return;
        if (e instanceof KeyboardEvent) {
          // Let Cmd+K still open the palette without skipping the intro.
          if ((e.metaKey || e.ctrlKey) && (e.key === "k" || e.key === "K")) {
            return;
          }
          // Ignore modifier-only presses with no key (Shift/Ctrl/Alt alone).
          if (e.key === "Shift" || e.key === "Control" || e.key === "Alt" || e.key === "Meta") {
            return;
          }
        }
        finish();
      };
      window.addEventListener("keydown", skipHandler);
      window.addEventListener("pointerdown", skipHandler);

      // Brief preamble so the scan-line has time to start sweeping before
      // the first character lands.
      await sleep(180);
      if (!running) return;

      const typeLine = async (
        el: HTMLElement,
        text: string,
        msPerChar: number
      ) => {
        el.classList.add("has-cursor");
        for (let i = 1; i <= text.length; i++) {
          if (!running) return;
          el.textContent = text.slice(0, i);
          await sleep(msPerChar);
        }
      };

      // Line 1: ~38 chars at 18ms/char ≈ 680ms — feels like fast deliberate typing.
      await typeLine(lines[0], originals[0], 18);
      if (!running) return;
      lines[0].classList.remove("has-cursor");
      await sleep(100);
      if (!running) return;

      // Line 2: ~94 chars at 7ms/char ≈ 660ms — keeps cadence flowing.
      await typeLine(lines[1], originals[1], 7);
      if (!running) return;

      // Final cursor blink on line 2, then fade. Total intro ~2.1s.
      await sleep(620);
      if (running) finish();
    };

    const seen = (() => {
      try {
        return localStorage.getItem(FLAG_KEY) === "1";
      } catch {
        return false;
      }
    })();

    if (!seen || forceReplay) {
      // Wait two frames so the reveal observer and other layout settle.
      requestAnimationFrame(() => requestAnimationFrame(playIntro));
    }

    // External replay (Cmd-K → Replay intro).
    document.addEventListener("hero:replay-intro", () => {
      try {
        localStorage.removeItem(FLAG_KEY);
      } catch {
        /* ignore */
      }
      window.scrollTo({ top: 0, behavior: "smooth" });
      playIntro();
    });
  })();
</script>

<script>
  // Cursor-follow spotlight on hero. Listener attached to the section itself so
  // it only fires while the cursor is over the hero — no global pointermove.
  // rAF-throttled to one paint per frame; default position keeps the gradient
  // soft when the cursor leaves.
  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero) return;
    if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
    if (window.matchMedia("(hover: none)").matches) return;

    let raf = 0;
    let nextX = 50;
    let nextY = -10;

    const onMove = (e: PointerEvent) => {
      const rect = hero.getBoundingClientRect();
      nextX = ((e.clientX - rect.left) / rect.width) * 100;
      nextY = ((e.clientY - rect.top) / rect.height) * 100;
      if (raf) return;
      raf = requestAnimationFrame(() => {
        hero.style.setProperty("--spot-x", `${nextX}%`);
        hero.style.setProperty("--spot-y", `${nextY}%`);
        raf = 0;
      });
    };

    const onLeave = () => {
      hero.style.setProperty("--spot-x", "50%");
      hero.style.setProperty("--spot-y", "-10%");
    };

    hero.addEventListener("pointermove", onMove, { passive: true });
    hero.addEventListener("pointerleave", onLeave);
  })();
</script>

<style>
  .text-muted-display {
    color: var(--color-muted);
  }
  .text-muted {
    color: var(--color-muted);
  }
  .text-faint {
    color: var(--color-faint);
  }
  .cursor-spotlight {
    pointer-events: none;
    position: absolute;
    inset: 0;
    z-index: 0;
    /* Default — sits softly above the headline area; the listener overwrites. */
    --spot-x: 50%;
    --spot-y: -10%;
    background: radial-gradient(
      600px circle at var(--spot-x) var(--spot-y),
      rgba(61, 82, 254, 0.08),
      transparent 60%
    );
    opacity: 0;
    transition: opacity 220ms ease;
  }
  /* Only fade in once a hover-capable, motion-allowed device is detected.
     The script also bails on those, so this rule is a CSS-side belt-and-braces. */
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    [data-hero]:hover .cursor-spotlight {
      opacity: 1;
    }
  }
  /* Light theme — accent darker, gradient should ease off so it doesn't muddy. */
  :root[data-theme="light"] .cursor-spotlight {
    background: radial-gradient(
      600px circle at var(--spot-x) var(--spot-y),
      rgba(36, 54, 199, 0.08),
      transparent 60%
    );
  }
</style>
