---
import Section from "./Section.astro";

/**
 * Stack — three buckets per the plan §4 ("Confident / Strong / Working knowledge").
 *
 * Each cluster carries a mono `$ stack --<flag>` prompt above the chips and types
 * them in on intersect (via the script below). Reduced-motion users see the
 * chips pre-rendered without animation.
 */
const buckets: Array<{
  label: string;
  flag: string; /* shown after `$ stack --` in the terminal prompt */
  hint: string;
  items: string[];
}> = [
  {
    label: "Confident · ship to production",
    flag: "confident",
    hint: "I'd answer interview questions on these without hedging.",
    items: [
      "Python",
      "Flask",
      "MySQL",
      "scikit-learn",
      "Pandas",
      "NumPy",
      "REST APIs",
      "Git",
      "Linux",
    ],
  },
  {
    label: "Strong · use regularly",
    flag: "strong",
    hint: "Comfortable, opinionated, but I'd defer to a specialist on edge cases.",
    items: [
      "TensorFlow",
      "Llama Index",
      "Redis",
      "Docker",
      "Celery",
      "AWS (EC2, S3, RDS)",
      "SQLAlchemy",
    ],
  },
  {
    label: "Working knowledge",
    flag: "working",
    hint: "Read code in these. Ramp-up is days, not weeks.",
    items: ["PyTorch", "Go", "Kafka", "React", "TypeScript", "Kubernetes"],
  },
];
---

<Section
  id="stack"
  eyebrow="Stack"
  title="What I ship in, what I'm comfortable in, and what I'm ramping on."
>
  <div class="grid grid-cols-1 gap-6 md:grid-cols-3">
    {
      buckets.map((b) => (
        <div
          class="reveal stack-cluster rounded-md border p-6"
          style="border-color: var(--color-hairline); background: var(--color-panel);"
          data-stack-cluster
        >
          <p class="stack-prompt" aria-hidden="true">
            <span class="stack-prompt-sigil">$</span>
            <span class="stack-prompt-cmd">stack --{b.flag}</span>
            <span class="stack-prompt-cursor" />
          </p>
          <h3
            class="text-white"
            style="font-size: 16px; font-weight: 600; letter-spacing: -0.01em;"
          >
            {b.label}
          </h3>
          <p class="stack-hint">{b.hint}</p>
          <ul class="mt-2 flex flex-wrap gap-1.5">
            {b.items.map((it) => (
              <li class="chip">{it}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</Section>

<script>
  /**
   * Stack reveal — types the chips of each cluster in one by one when the
   * cluster enters the viewport. Cursor blinks while typing and hides once
   * the cluster is done. Reduced-motion shows everything immediately.
   */
  (() => {
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const clusters = Array.from(
      document.querySelectorAll<HTMLElement>("[data-stack-cluster]")
    );
    if (clusters.length === 0) return;

    if (reduce) {
      clusters.forEach((c) => {
        c.classList.add("is-typed");
        c.querySelectorAll<HTMLElement>(".chip").forEach((chip) =>
          chip.classList.add("is-typed")
        );
      });
      return;
    }

    const animate = (cluster: HTMLElement) => {
      const chips = Array.from(
        cluster.querySelectorAll<HTMLElement>(".chip")
      );
      // 55ms per chip keeps the longest cluster (9 items) under 500ms.
      const perChip = 55;
      chips.forEach((chip, i) => {
        window.setTimeout(() => chip.classList.add("is-typed"), i * perChip);
      });
      window.setTimeout(
        () => cluster.classList.add("is-typed"),
        chips.length * perChip + 240
      );
    };

    const io = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) {
            animate(entry.target as HTMLElement);
            io.unobserve(entry.target);
          }
        }
      },
      { threshold: 0.25 }
    );
    clusters.forEach((c) => io.observe(c));
  })();
</script>
