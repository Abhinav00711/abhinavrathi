---
/**
 * Persistent floating "Get in touch" CTA — bottom-right, desktop only.
 *
 * Visibility rules:
 *   - Hidden under 1100px (mobile has the inline Email button + Cmd-K).
 *   - Hidden when the Hero is in view (already has CTAs above the fold).
 *   - Hidden when the Contact section is in view (button would be redundant).
 *   - Hidden under prefers-reduced-motion is NOT enforced — this is a static
 *     pill, not a motion effect; reduced-motion only kills its fade.
 *
 * On case-study pages there is no Hero or Contact section, so the IOs simply
 * never fire and the CTA stays shown — which is the desired behavior.
 */
---

<a
  href="mailto:rathiabhinav01@gmail.com?subject=Senior%20role%20inquiry&body=Hi%20Abhinav%2C%0A%0A"
  class="floating-contact"
  data-floating-contact
  data-shown="false"
  aria-label="Email Abhinav"
>
  <svg
    viewBox="0 0 24 24"
    width="14"
    height="14"
    fill="none"
    stroke="currentColor"
    stroke-width="1.8"
    aria-hidden="true"
  >
    <rect x="3" y="5" width="18" height="14" rx="2" />
    <path d="m3 7 9 6 9-6" />
  </svg>
  <span>Get in touch</span>
</a>

<script>
  (() => {
    const cta = document.querySelector<HTMLElement>("[data-floating-contact]");
    if (!cta) return;

    const hero = document.querySelector<HTMLElement>("[data-hero]");
    const contact = document.getElementById("contact");

    // Default state: assume hero is in view at page-load (it always is on the
    // homepage). On pages without a hero we want the CTA visible immediately.
    let heroVisible = !!hero;
    let contactVisible = false;

    const update = () => {
      cta.dataset.shown = !heroVisible && !contactVisible ? "true" : "false";
    };

    if (hero) {
      const heroIO = new IntersectionObserver(
        (entries) => {
          heroVisible = entries[0].isIntersecting;
          update();
        },
        // Trip "out of view" before the hero fully leaves so the CTA fades in
        // around the time recruiters are reaching the work grid.
        { threshold: 0.2 }
      );
      heroIO.observe(hero);
    }
    if (contact) {
      const contactIO = new IntersectionObserver(
        (entries) => {
          contactVisible = entries[0].isIntersecting;
          update();
        },
        { threshold: 0.15 }
      );
      contactIO.observe(contact);
    }

    update();
  })();
</script>

<style>
  .floating-contact {
    /* Mobile-first: hidden. The viewport rule below opts in for ≥1100px. */
    display: none;
    position: fixed;
    bottom: 24px;
    right: 24px;
    z-index: 30;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    background: var(--color-accent);
    color: white;
    border-radius: var(--radius-pill);
    box-shadow:
      0 0 0 1px var(--color-accent),
      0 12px 32px -8px var(--color-accent-glow);
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 200ms ease,
      transform 200ms ease,
      background 160ms ease;
    pointer-events: none;
  }
  @media (min-width: 1100px) {
    .floating-contact {
      display: inline-flex;
    }
  }
  .floating-contact[data-shown="true"] {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }
  .floating-contact:hover {
    background: #2a3fff;
    transform: translateY(-1px);
  }
  /* Light theme: keep the accent fill but ensure the icon stays white. */
  :root[data-theme="light"] .floating-contact svg {
    color: white;
  }
  @media (prefers-reduced-motion: reduce) {
    .floating-contact {
      transition: opacity 0.01ms;
      transform: none !important;
    }
  }
</style>
