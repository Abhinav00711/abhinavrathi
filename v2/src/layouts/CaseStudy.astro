---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import CommandPalette from "@components/CommandPalette.astro";
import ScrollProgress from "@components/ScrollProgress.astro";
import RevealMotion from "@components/RevealMotion.astro";

interface Props {
  /** Slug of this case study — drives the matched view-transition-name
   *  shared with the homepage tile, so the title morphs across documents
   *  in browsers that support cross-document View Transitions. */
  slug: string;
  title: string;
  summary: string;
  role: string;
  year: number;
  tech: string[];
  metrics: Array<{ label: string; value: string }>;
  anonymized?: boolean;
  repo?: string;
  live?: string;
  cover?: ImageMetadata;
  /** Estimated reading time, e.g. "4 min read". Computed by the
   *  remark-reading-time plugin and injected via remarkPluginFrontmatter. */
  readTime?: string;
  prev?: { id: string; title: string };
  next?: { id: string; title: string };
}
const {
  slug,
  title,
  summary,
  role,
  year,
  tech,
  metrics,
  anonymized,
  repo,
  live,
  cover,
  readTime,
  prev,
  next,
} = Astro.props;
const transitionName = `case-${slug}`;

const base = import.meta.env.BASE_URL.replace(/\/$/, "");

// Slug-specific OG image (generated by scripts/og-case-study-gen.py).
// Layout treats this as path-only and prepends siteUrl + base.
const ogImage = `/work/${slug}/og.png`;
const canonicalPath = `/work/${slug}/`;
---

<Layout
  title={`${title} — Abhinav Rathi`}
  description={summary}
  canonicalPath={canonicalPath}
  ogImage={ogImage}
>
  <ScrollProgress />
  <Nav />

  <main id="main" class="pt-32 pb-24">
    <article class="container-prose">
      <a
        href={`${base}/#work`}
        class="font-mono text-[13px]"
        style="color: var(--color-muted);"
        >← Back to work</a
      >

      <header class="mt-8">
        {
          anonymized && (
            <p
              class="mono inline-block rounded-full border px-2.5 py-1 text-[11px] uppercase tracking-wider"
              style="border-color: var(--color-hairline-strong); color: var(--color-accent-text);"
            >
              Anonymized · prop trading firm
            </p>
          )
        }
        <h1
          class="headline mt-4"
          style={`font-size: var(--text-h1); max-width: 22ch; view-transition-name: ${transitionName};`}
        >
          {title}
        </h1>
        <p class="mt-5 text-[18px] max-w-prose" style="color: var(--color-muted);">
          {summary}
        </p>

        <dl
          class="mono mt-8 grid grid-cols-2 gap-x-8 gap-y-4 text-[13px] sm:grid-cols-4"
          style="color: var(--color-body);"
        >
          <div>
            <dt class="uppercase tracking-wider" style="color: var(--color-faint);">
              Role
            </dt>
            <dd class="mt-1">{role}</dd>
          </div>
          <div>
            <dt class="uppercase tracking-wider" style="color: var(--color-faint);">
              Year
            </dt>
            <dd class="mt-1">{year}</dd>
          </div>
          {
            readTime && (
              <div>
                <dt
                  class="uppercase tracking-wider"
                  style="color: var(--color-faint);"
                >
                  Read
                </dt>
                <dd class="mt-1">{readTime}</dd>
              </div>
            )
          }
          {
            repo && (
              <div>
                <dt
                  class="uppercase tracking-wider"
                  style="color: var(--color-faint);"
                >
                  Repo
                </dt>
                <dd class="mt-1">
                  <a
                    href={repo}
                    target="_blank"
                    rel="noreferrer noopener"
                    style="color: var(--color-accent-text);"
                  >
                    GitHub →
                  </a>
                </dd>
              </div>
            )
          }
          {
            live && (
              <div>
                <dt
                  class="uppercase tracking-wider"
                  style="color: var(--color-faint);"
                >
                  Live
                </dt>
                <dd class="mt-1">
                  <a
                    href={live}
                    target="_blank"
                    rel="noreferrer noopener"
                    style="color: var(--color-accent-text);"
                  >
                    Visit →
                  </a>
                </dd>
              </div>
            )
          }
        </dl>
      </header>

      {
        cover && (
          <figure
            class="cs-cover mt-10 overflow-hidden border"
            style="border-color: var(--color-hairline); border-radius: var(--radius-md); background: var(--color-panel);"
          >
            <Image
              src={cover}
              alt={`${title} — cover`}
              widths={[640, 960, 1200]}
              sizes="(min-width: 1120px) 1120px, 100vw"
              loading="eager"
              decoding="async"
            />
          </figure>
        )
      }

      {
        metrics.length > 0 && (
          <ul
            class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-md border md:grid-cols-3 lg:grid-cols-4"
            style="border-color: var(--color-hairline); background: var(--color-hairline);"
          >
            {metrics.map((m) => (
              <li
                class="flex flex-col gap-1 px-4 py-3"
                style="background: var(--color-surface);"
              >
                <span
                  class="mono text-[11px] uppercase tracking-wider"
                  style="color: var(--color-faint);"
                >
                  {m.label}
                </span>
                <span class="mono text-[15px] text-white">{m.value}</span>
              </li>
            ))}
          </ul>
        )
      }

      <hr class="hairline my-12" />

      <div class="prose-body cs-snap">
        <slot />
      </div>

      <ul class="mt-10 flex flex-wrap gap-1.5">
        {tech.map((t) => <li class="chip">{t}</li>)}
      </ul>

      <nav
        class="mt-16 flex items-center justify-between border-t pt-8"
        style="border-color: var(--color-hairline);"
        aria-label="Case study navigation"
      >
        {
          prev ? (
            <a
              href={`${base}/work/${prev.id}/`}
              class="font-mono text-[13px]"
              style="color: var(--color-muted);"
            >
              ← {prev.title}
            </a>
          ) : (
            <span />
          )
        }
        {
          next ? (
            <a
              href={`${base}/work/${next.id}/`}
              class="font-mono text-[13px] text-right"
              style="color: var(--color-muted);"
            >
              {next.title} →
            </a>
          ) : (
            <span />
          )
        }
      </nav>
    </article>
  </main>

  {/* Mobile-only sticky bottom-bar (Prev · Email · Next) — thumb-friendly
      navigation between case studies on small screens. Hidden on ≥720px
      where the inline prev/next nav above is already comfortable to reach. */}
  <nav class="cs-mobilebar" aria-label="Case study mobile navigation">
    {
      prev ? (
        <a href={`${base}/work/${prev.id}/`} class="cs-mobilebar__btn" aria-label={`Previous case study: ${prev.title}`}>
          <span aria-hidden="true">←</span>
          <span class="cs-mobilebar__label">Prev</span>
        </a>
      ) : (
        <span class="cs-mobilebar__btn cs-mobilebar__btn--disabled" aria-hidden="true">
          <span>←</span>
          <span class="cs-mobilebar__label">Prev</span>
        </span>
      )
    }
    <a
      href="mailto:rathiabhinav01@gmail.com?subject=Senior%20role%20inquiry&body=Hi%20Abhinav%2C%0A%0A"
      class="cs-mobilebar__btn cs-mobilebar__btn--primary"
      aria-label="Email Abhinav"
    >
      <span class="cs-mobilebar__label">Email</span>
    </a>
    {
      next ? (
        <a href={`${base}/work/${next.id}/`} class="cs-mobilebar__btn" aria-label={`Next case study: ${next.title}`}>
          <span class="cs-mobilebar__label">Next</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="cs-mobilebar__btn cs-mobilebar__btn--disabled" aria-hidden="true">
          <span class="cs-mobilebar__label">Next</span>
          <span>→</span>
        </span>
      )
    }
  </nav>

  <Footer />
  <CommandPalette />
  <RevealMotion />
</Layout>

<style is:global>
  .prose-body {
    color: var(--color-body);
    font-size: 17px;
    line-height: 1.75;
  }
  .prose-body > * + * {
    margin-top: 1.25em;
  }
  .prose-body h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    color: white;
    letter-spacing: -0.01em;
    margin-top: 2.5em;
    margin-bottom: 0.5em;
  }
  .prose-body h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: white;
    margin-top: 2em;
    margin-bottom: 0.4em;
  }
  .prose-body blockquote {
    margin: 1.5em 0;
    padding: 1em 1.25em;
    border-left: 2px solid var(--color-accent);
    background: var(--color-panel);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-body);
  }
  .prose-body blockquote strong {
    color: white;
  }
  .prose-body a {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-body code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.35em;
    background: var(--color-panel);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    color: var(--color-body);
  }
  .prose-body ul,
  .prose-body ol {
    padding-left: 1.5em;
  }
  .prose-body li {
    margin-top: 0.4em;
  }
  /* Cover image — bleeds to article width, 16:9 aspect, accent border on hover. */
  .cs-cover {
    aspect-ratio: 16 / 9;
  }
  .cs-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ---------------------------------------------------------------------------
   * Scroll-snap on the case-study reading view.
   *
   * Snap points sit at every <h2> so a fast-scrolling recruiter lands on a
   * section header rather than mid-paragraph. `proximity` (not `mandatory`) so
   * thumb-flicking still feels analogue — it's a nudge, not a magnet.
   *
   * Gated by a tall-viewport media query (snap on a 720-tall laptop fights the
   * sticky header) and disabled entirely under `prefers-reduced-motion`.
   * Scroll-margin-top accounts for the 64px fixed nav.
   * --------------------------------------------------------------------------*/
  @media (min-height: 900px) and (prefers-reduced-motion: no-preference) {
    .cs-snap {
      scroll-snap-type: y proximity;
    }
    .cs-snap > h2 {
      scroll-snap-align: start;
      scroll-snap-stop: normal;
      scroll-margin-top: 96px;
    }
  }

  /* ---------------------------------------------------------------------------
   * Mobile sticky bottom-bar — thumb-friendly Prev · Email · Next.
   *
   * Hidden ≥720px (where the inline prev/next nav above the footer is enough).
   * Below that, fixed to the bottom edge with safe-area padding for iOS. The
   * bottom of `<main>` already has 96px (pb-24) of padding so content never
   * sits behind the bar.
   * --------------------------------------------------------------------------*/
  .cs-mobilebar {
    display: none;
  }
  @media (max-width: 719.98px) {
    .cs-mobilebar {
      display: flex;
      position: fixed;
      left: 12px;
      right: 12px;
      bottom: calc(12px + env(safe-area-inset-bottom, 0px));
      gap: 6px;
      padding: 6px;
      border: 1px solid var(--color-hairline-strong);
      background: color-mix(in srgb, var(--color-surface) 92%, transparent);
      backdrop-filter: blur(8px);
      border-radius: var(--radius-pill);
      z-index: 60;
      box-shadow: 0 12px 32px -12px rgba(0, 0, 0, 0.5);
    }
    .cs-mobilebar__btn {
      flex: 1 1 0;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      min-height: 44px;
      padding: 0 12px;
      border-radius: var(--radius-pill);
      font-family: var(--font-mono);
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--color-body);
      background: transparent;
    }
    .cs-mobilebar__btn--primary {
      background: var(--color-accent);
      color: white;
    }
    .cs-mobilebar__btn--disabled {
      opacity: 0.35;
    }
    .cs-mobilebar__label {
      font-weight: 500;
    }
  }

  /* Architecture diagram figure — used inside MDX as <figure class="arch">. */
  .prose-body figure.arch {
    margin: 2em 0;
    padding: 12px;
    border: 1px solid var(--color-hairline);
    background: var(--color-panel);
    border-radius: var(--radius-md);
  }
  .prose-body figure.arch img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
  }
  .prose-body figure.arch figcaption {
    margin-top: 12px;
    padding: 0 4px;
    font-size: 14px;
    color: var(--color-muted);
    line-height: 1.55;
  }
</style>
