---
import "@styles/global.css";
import ThemeBoot from "@components/ThemeBoot.astro";
import FontFace from "@components/FontFace.astro";
import HelpModal from "@components/HelpModal.astro";
import FloatingContact from "@components/FloatingContact.astro";
import KonamiTheme from "@components/KonamiTheme.astro";

interface Props {
  title?: string;
  description?: string;
  /** Path-only canonical (e.g. "/work/position-recon"). Optional — defaults to current page. */
  canonicalPath?: string;
  ogImage?: string;
  noindex?: boolean;
}

const {
  title = "Abhinav Rathi — ML engineer at Axxela",
  description = "ML engineer shipping production Python at a prop trading firm. Models, services, and the infrastructure that puts the two together — Flask, MySQL, eval harnesses, and the latency budget around models that decide on real trades.",
  canonicalPath,
  ogImage = "/og-default.png",
  noindex = false,
} = Astro.props;

const siteUrl = Astro.site?.toString().replace(/\/$/, "") ?? "";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalHref = canonicalPath
  ? `${siteUrl}${base}${canonicalPath}`
  : new URL(Astro.url.pathname, Astro.site).toString();
const ogImageUrl = ogImage.startsWith("http")
  ? ogImage
  : `${siteUrl}${base}${ogImage}`;

// JSON-LD Person schema — surfaces in Google Knowledge Panel and improves
// recruiter-side disambiguation.
const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Abhinav Rathi",
  url: canonicalHref,
  email: "mailto:rathiabhinav01@gmail.com",
  jobTitle: "ML Engineer",
  worksFor: {
    "@type": "Organization",
    name: "Axxela",
  },
  sameAs: [
    "https://github.com/Abhinav00711",
    "https://linkedin.com/in/rathiabhinav01",
  ],
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalHref} />
    {noindex && <meta name="robots" content="noindex" />}

    <!-- favicons -->
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <link rel="apple-touch-icon" href={`${base}/apple-touch-icon.png`} />
    <meta name="theme-color" content="#0A0A0A" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#FAFAF9" media="(prefers-color-scheme: light)" />
    <meta name="color-scheme" content="dark light" />
    <meta name="author" content="Abhinav Rathi" />
    <!-- Stop iOS from auto-linking number-shaped strings as phone numbers. -->
    <meta name="format-detection" content="telephone=no" />
    <!-- RSS discovery — surfaces the feed in browser readers and search engines. -->
    <link
      rel="alternate"
      type="application/rss+xml"
      title="Abhinav Rathi · Writing"
      href={`${base}/rss.xml`}
    />
    <!-- Identity verification (Mastodon-style rel=me, also helpful to bots). -->
    <link rel="me" href="https://github.com/Abhinav00711" />
    <link rel="me" href="https://linkedin.com/in/rathiabhinav01" />

    <!-- Preload the two highest-impact fonts so the headline + metric strip
         don't FOIT or swap visibly. -->
    <link rel="preload" href={`${base}/fonts/Geist.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${base}/fonts/InterVariable.woff2`} as="font" type="font/woff2" crossorigin />

    <!-- OG -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${title} — open graph cover`} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:site_name" content="Abhinav Rathi" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <!-- JSON-LD -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />

    <!-- Privacy-first analytics — drop-in slot. Replace with Plausible/Vercel
         Analytics tag later. Intentionally NOT loading GA4. -->

    <!-- @font-face declarations — base-aware, see FontFace.astro. -->
    <FontFace />

    <!-- Theme boot — runs sync to prevent FOUC. MUST stay before <body>. -->
    <ThemeBoot />
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <!-- Singletons mounted once globally so every page (homepage and case
         studies) gets the same shortcut surface. Keep them last in <body>. -->
    <HelpModal />
    <FloatingContact />
    <KonamiTheme />
  </body>
</html>
