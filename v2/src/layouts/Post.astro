---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import Layout from "@layouts/Layout.astro";
import Nav from "@components/Nav.astro";
import Footer from "@components/Footer.astro";
import CommandPalette from "@components/CommandPalette.astro";
import ScrollProgress from "@components/ScrollProgress.astro";
import RevealMotion from "@components/RevealMotion.astro";

interface Props {
  slug: string;
  title: string;
  summary: string;
  published: Date;
  tags?: string[];
  cover?: ImageMetadata;
  draft?: boolean;
  /** Estimated reading time string from the remark-reading-time plugin. */
  readTime?: string;
}
const {
  slug,
  title,
  summary,
  published,
  tags = [],
  cover,
  draft,
  readTime,
} = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonicalPath = `/writing/${slug}/`;

const fmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout
  title={`${title} — Abhinav Rathi`}
  description={summary}
  canonicalPath={canonicalPath}
  noindex={draft}
>
  <ScrollProgress />
  <Nav />

  <main id="main" class="pt-32 pb-24">
    <article class="container-prose" style="max-width: 760px;">
      <a
        href={`${base}/#writing`}
        class="font-mono text-[13px]"
        style="color: var(--color-muted);"
        >← Back to writing</a
      >

      <header class="mt-8">
        {
          draft && (
            <p
              class="mono inline-block rounded-full border px-2.5 py-1 text-[11px] uppercase tracking-wider"
              style="border-color: var(--color-hairline-strong); color: var(--color-accent-text);"
            >
              Draft · outline
            </p>
          )
        }
        <h1
          class="headline mt-4"
          style="font-size: var(--text-h1); max-width: 22ch;"
        >
          {title}
        </h1>
        <p class="mt-5 text-[18px] max-w-prose" style="color: var(--color-muted);">
          {summary}
        </p>
        <p
          class="mono mt-6 text-[13px] uppercase tracking-wider"
          style="color: var(--color-faint);"
        >
          {fmt.format(published)}
          {readTime && <> · {readTime}</>}
          {tags.length > 0 && <> · {tags.join(" · ")}</>}
        </p>
      </header>

      {
        cover && (
          <figure
            class="mt-10 overflow-hidden border"
            style="border-color: var(--color-hairline); border-radius: var(--radius-md); aspect-ratio: 16 / 9; background: var(--color-panel);"
          >
            <Image
              src={cover}
              alt=""
              widths={[640, 960, 1200]}
              sizes="(min-width: 760px) 760px, 100vw"
              loading="eager"
              decoding="async"
              style="width: 100%; height: 100%; object-fit: cover;"
            />
          </figure>
        )
      }

      <hr class="hairline my-12" />

      <div class="prose-body">
        <slot />
      </div>
    </article>
  </main>

  <Footer />
  <CommandPalette />
  <RevealMotion />
</Layout>

<style is:global>
  /* Same prose-body rules as CaseStudy — kept duplicated rather than shared
     because tweaking each side's typography independently is more useful
     than DRY here. If a third long-form template appears, factor out. */
  .prose-body {
    color: var(--color-body);
    font-size: 17px;
    line-height: 1.75;
  }
  .prose-body > * + * {
    margin-top: 1.25em;
  }
  .prose-body h2 {
    font-family: var(--font-display);
    font-size: 28px;
    font-weight: 600;
    color: white;
    letter-spacing: -0.01em;
    margin-top: 2.5em;
    margin-bottom: 0.5em;
  }
  .prose-body h3 {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 600;
    color: white;
    margin-top: 2em;
    margin-bottom: 0.4em;
  }
  .prose-body blockquote {
    margin: 1.5em 0;
    padding: 1em 1.25em;
    border-left: 2px solid var(--color-accent);
    background: var(--color-panel);
    border-radius: 0 var(--radius-sm) var(--radius-sm) 0;
    color: var(--color-body);
  }
  .prose-body a {
    color: var(--color-accent-text);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .prose-body code {
    font-family: var(--font-mono);
    font-size: 0.85em;
    padding: 0.15em 0.35em;
    background: var(--color-panel);
    border: 1px solid var(--color-hairline);
    border-radius: 4px;
    color: var(--color-body);
  }
  .prose-body ul,
  .prose-body ol {
    padding-left: 1.5em;
  }
  .prose-body li {
    margin-top: 0.4em;
  }
</style>
